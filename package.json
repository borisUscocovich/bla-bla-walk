{
  "name": "bla-bla-walk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "api": "python -m uvicorn bla_bla_walk.main:app --app-dir backend --host 127.0.0.1 --port 8000",
    "contracts:generate": "python backend/export_contract.py && openapi-typescript .cache/openapi.json -o src/interfaces.ts",
    "test": "vitest run",
    "lint": "eslint src vite.config.ts && tsc --noEmit",
    "fmt": "prettier --write src vite.config.ts tsconfig.json package.json index.html eslint.config.js",
    "fmt:check": "prettier --check src vite.config.ts tsconfig.json package.json index.html eslint.config.js"
  },
  "engines": { "node": ">=22.12" }
}
